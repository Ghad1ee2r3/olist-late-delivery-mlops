# copy to .env and change the password
# .env is gitignored. do not commit real secrets.
# APP_ENV=dev
# LOG_LEVEL=INFO
POSTGRES_USER=admin
POSTGRES_PASSWORD=change_me
POSTGRES_DB=olist_db
POSTGRES_PORT=5437

# used inside the compose network (hostname = service name)
DATABASE_URL=postgresql://admin:change_me@postgres:5432/olist_db

API_PORT=8000
